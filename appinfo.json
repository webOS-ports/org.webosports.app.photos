{
    "title": "Photos & Videos",
    "id": "org.webosports.app.photos",
    "version": "1.0.0",
    "vendor": "webOS Ports",
    "vendor_url": "https://github.com/webOS-ports/org.webosports.app.photos",
    "type": "qml",
    "main": "qml/main.qml",
    "noWindow": true,
    "useWebEngine": false,
    "useLuneOSStyle": true,
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "uiRevision": "2",
    "dockMode": true,
    "exhibitionMode": true,
    "exhibitionModeOptions": { "title": "Photos" },
    "requiredPermissions": [ "application.operation", "application.launcher", "database.operation",
                             "mediapermissions-service.operation", "photosservice.operation",
                             "accountsservice.management", "systemsettings.management", "display.operation",
                             "print.operation" ],
    "mimeTypes": [
        { "mime": "image/jpeg", "extension": "jpg" },
        { "mime": "image/jpeg", "extension": "jpeg" },
        { "mime": "image/png", "extension": "png" },
        { "mime": "image/gif", "extension": "gif" },
        { "mime": "image/bmp", "extension": "bmp" },
        { "mime": "image/webp", "extension": "webp" }
    ],
    "keywords": [ "Photos", "Pictures", "Videos", "Albums", "Gallery", "Slideshow", "Camera Roll" ]
}
